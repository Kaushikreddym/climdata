# climdata_gui
climdata_gui/conf/

# Working artifacts created when executing example notebooks.
# nbconvert runs with the notebook's directory as cwd, so _ensure_local_conf()
# drops a conf/ copy there, and data/ holds local downloads or symlinks to
# machine-specific archives. Neither belongs in the repo.
docs/examples/**/conf/
docs/examples/**/data/

# Working copy of climdata/conf, dropped into cwd by _ensure_local_conf()
/conf/
